# API base URL — points to Nginx in production, or directly to api-gateway in dev
VITE_API_URL=http://localhost

# Sentry DSN for the frontend.  Leave empty to disable Sentry.
# Get your DSN from https://sentry.io → Project → Settings → Client Keys (DSN).
VITE_SENTRY_DSN=

# Fraction of frontend transactions sent to Sentry (0.0 – 1.0).
# Keep at 1.0 for local lab; reduce for high-traffic environments.
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0

# OpenTelemetry browser traces → Jaeger OTLP HTTP (port 4318).
# Leave unset in Vite dev to use same-origin /otel/v1/traces (see vite.config.ts proxy).
# For production or custom collectors, set the full URL (must allow CORS from the UI origin).
# VITE_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
