SERVICE_NAME=notification-worker
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
LOG_LEVEL=INFO

# OpenTelemetry OTLP (Jaeger via the Collector). See infra/.env.example.
OTLP_ENDPOINT=http://otel-collector:4317

METRICS_PORT=9100

# ─────────────────────────────────────────────
# SMTP delivery
# ─────────────────────────────────────────────
# Default: Toxiproxy → MailHog (local dev catcher, no auth needed).
#   - View captured emails at http://localhost:8025
#   - Inject failures via the Toxiproxy management API at http://localhost:8474
SMTP_HOST=toxiproxy
SMTP_PORT=11025
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# To deliver to a real inbox (e.g. emailhook.site) use a real SMTP provider:
#
#   Gmail (app password required — https://myaccount.google.com/apppasswords)
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_USE_STARTTLS=true
#     SMTP_USERNAME=your-address@gmail.com
#     SMTP_PASSWORD=your-app-password
#
#   SendGrid
#     SMTP_HOST=smtp.sendgrid.net
#     SMTP_PORT=587
#     SMTP_USE_STARTTLS=true
#     SMTP_USERNAME=apikey
#     SMTP_PASSWORD=your-sendgrid-api-key

# ─────────────────────────────────────────────
# Email addresses
# ─────────────────────────────────────────────
EMAIL_FROM=notifications@saas-debug-lab.local
EMAIL_TO=your-uuid@emailhook.site

# ─────────────────────────────────────────────
# Sentry
# ─────────────────────────────────────────────
# Leave empty to disable. SMTP delivery failures and unexpected Kafka
# processing errors will be captured as separate Sentry issues with
# task_id, smtp_host, and recipient context attached.
SENTRY_DSN=
