SERVICE_NAME=scheduler-worker
LOG_LEVEL=INFO

# OpenTelemetry OTLP (Jaeger via the Collector). See infra/.env.example.
OTLP_ENDPOINT=http://otel-collector:4317

METRICS_PORT=9100

# ─────────────────────────────────────────────
# Celery
# ─────────────────────────────────────────────
# Uses Redis DB 2 as both broker and result backend.
# DB 0 and DB 1 are reserved for task-service and auth-service caches.
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─────────────────────────────────────────────
# Postgres (cleanup_old_tasks)
# ─────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=saas
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# ─────────────────────────────────────────────
# Kafka (retry_failed_webhooks — drains webhook_dlq topic)
# ─────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─────────────────────────────────────────────
# Webhook retry (retry_failed_webhooks)
# ─────────────────────────────────────────────
# Must match the WEBHOOK_URL in webhook-dispatcher so retried events
# reach the same endpoint as original delivery attempts.
WEBHOOK_URL=http://nginx/external/receive-webhook
WEBHOOK_TIMEOUT=10

# ─────────────────────────────────────────────
# Task cleanup (cleanup_old_tasks)
# ─────────────────────────────────────────────
# Delete completed tasks older than this many minutes. Set to 0 to disable.
# Default 5 = delete anything completed more than 5 minutes ago.
CLEANUP_COMPLETED_TASKS_MINUTES=5
# Beat cadence in seconds. Defaults match the previous literals (60s DLQ replay, 300s cleanup).
DLQ_REPLAY_INTERVAL_SECONDS=60
CLEANUP_INTERVAL_SECONDS=300

# ─────────────────────────────────────────────
# Sentry
# ─────────────────────────────────────────────
# Set to your project DSN to enable error reporting and task performance traces.
# Leave empty (default) to disable Sentry entirely.
SENTRY_DSN=
