SERVICE_NAME=scheduler-worker
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# Celery
# ─────────────────────────────────────────────
# Uses Redis DB 2 as both broker and result backend.
# DB 0 and DB 1 are reserved for task-service and auth-service caches.
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─────────────────────────────────────────────
# Postgres (cleanup_old_tasks)
# ─────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=saas
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# ─────────────────────────────────────────────
# Kafka (retry_failed_webhooks — drains webhook_dlq topic)
# ─────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─────────────────────────────────────────────
# Webhook retry (retry_failed_webhooks)
# ─────────────────────────────────────────────
# Must match the WEBHOOK_URL in webhook-dispatcher so retried events
# reach the same endpoint as original delivery attempts.
WEBHOOK_URL=http://webhook-simulator:8001/receive-webhook
WEBHOOK_TIMEOUT=10

# ─────────────────────────────────────────────
# Task cleanup (cleanup_old_tasks)
# ─────────────────────────────────────────────
# Delete completed tasks older than this many days. Set to 0 to disable.
CLEANUP_COMPLETED_TASKS_DAYS=30

# ─────────────────────────────────────────────
# Sentry
# ─────────────────────────────────────────────
# Set to your project DSN to enable error reporting and task performance traces.
# Leave empty (default) to disable Sentry entirely.
SENTRY_DSN=
