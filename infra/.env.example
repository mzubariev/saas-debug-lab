# Required for Postgres + the one-shot `migrations` service (Alembic).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

KAFKA_BROKER=kafka:9092

REDIS_HOST=redis

SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Datadog Agent (only when using `docker-compose.datadog.yml`)
#
#   docker compose -f docker-compose.yml -f docker-compose.datadog.yml \
#     --profile core --profile datadog up -d
#
# Do not combine the `datadog` profile with `observability` (Jaeger / OTel Collector).
# ─────────────────────────────────────────────────────────────────────────────

# Required for Datadog — https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=

# Datadog intake site — datadoghq.eu for EU, etc.
DD_SITE=datadoghq.com

# Shared tags applied to traces, metrics, and logs from the Datadog compose override.
DD_ENV=dev
DD_VERSION=1.0.0

# ─────────────────────────────────────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Observability tool URLs ───────────────────────────────────────────────────
# Used by Grafana provisioning (${VAR} interpolation) and Python services
# (os.getenv). Change only if you remap container ports or run tools remotely.
GRAFANA_BASE_URL=http://localhost:3000
JAEGER_BASE_URL=http://localhost:16686
KIBANA_BASE_URL=http://localhost:5601
KIBANA_INDEX_ID=3ed629f0-365c-11f1-bbf7-3bf617a85e7c
# Replace with your actual GitHub repo path to make runbook links clickable.
GITHUB_REPO_URL=https://github.com/YOUR_GITHUB_REPO