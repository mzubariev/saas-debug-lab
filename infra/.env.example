# Required for Postgres + the one-shot `migrations` service (Alembic).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

KAFKA_BROKER=kafka:9092

REDIS_HOST=redis

SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ─────────────────────────────────────────────────────────────────────────────
# Datadog
# Activate the "datadog" profile to start the agent:
#   docker compose --profile core --profile datadog up
# ─────────────────────────────────────────────────────────────────────────────

# Required — your Datadog API key (https://app.datadoghq.com/organization-settings/api-keys)
DD_API_KEY=

# Datadog intake site — change to datadoghq.eu for EU region, etc.
DD_SITE=datadoghq.com

# Shared tags applied to every trace, metric, and log line across all services.
# Increment DD_VERSION on every release to track deploys in Datadog.
DD_ENV=dev
DD_VERSION=1.0.0

# ─── Tracing mode (one primary tracer per process — see README “Tracing modes”) ───
#
# Mode A — OpenTelemetry → Jaeger (default for this lab):
#   DD_TRACE_ENABLED=false
#   Applications export OTLP to otel-collector:4317; Collector forwards to Jaeger (UI :16686).
#
# Mode B — Datadog APM only (ddtrace-run in Docker CMD):
#   DD_TRACE_ENABLED=true
#   The OpenTelemetry SDK registration in app code is SKIPPED to avoid duplicate spans
#   vs ddtrace. Use Datadog APM for traces; Kafka W3C injection is disabled.
#
# Set to "false" to disable APM tracing without removing ddtrace-run from Dockerfiles.
DD_TRACE_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# OpenTelemetry → Datadog Agent (optional; still use Mode A + DD_TRACE_ENABLED=false)
# Start Jaeger + Collector:  docker compose --profile observability up -d jaeger otel-collector
# Start Agent:   docker compose --profile datadog up -d datadog-agent
# The Agent listens for OTLP gRPC on port 4317 when DD_OTLP_CONFIG_* is set in compose.
# When OTLP_DATADOG_ENDPOINT is set, keep DD_TRACE_ENABLED=false unless you intentionally
# want both OTLP and ddtrace (duplicate traces in Datadog).
# OTLP_DATADOG_ENDPOINT=http://datadog-agent:4317
OTLP_DATADOG_ENDPOINT=