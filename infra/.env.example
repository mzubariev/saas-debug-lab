# Required for Postgres + the one-shot `migrations` service (Alembic).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

KAFKA_BROKER=kafka:9092

REDIS_HOST=redis

SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ─────────────────────────────────────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Observability tool URLs ───────────────────────────────────────────────────
# Used by Grafana provisioning (${VAR} interpolation) and Python services
# (os.getenv). Change only if you remap container ports or run tools remotely.
GRAFANA_BASE_URL=http://localhost:3000
GRAFANA_BASE_URL_IP=http://127.0.0.1:3000
JAEGER_BASE_URL=http://localhost:16686
KIBANA_BASE_URL=http://localhost:5601
SENTRY_BASE_URL_PROJECT=https://<key>@<org>.sentry.io/issues/?project=<project>
# Replace with your actual GitHub repo path to make runbook links clickable.
GITHUB_REPO_URL=https://github.com/YOUR_GITHUB_REPO