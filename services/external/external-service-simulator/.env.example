SERVICE_NAME=external-service-simulator

# URL of integration-service inbound endpoint (used by /trigger-event)
# URL the simulator POSTs to when /trigger-event is called.
# Routes through the api-gateway so the full request path is exercised.
INTEGRATION_SERVICE_WEBHOOK_URL=http://api-gateway:8000/webhooks/inbound

# Default behavior when no query params are passed to /receive-webhook.
# Per-request overrides via query params always take precedence.
DEFAULT_FAIL_RATE=0.0      # 0.0–1.0 probability of returning 500
DEFAULT_DELAY=0.0          # seconds to sleep before responding
DEFAULT_STATUS=200         # HTTP status code to return on success

LOG_LEVEL=INFO

# OpenTelemetry traces (same default as other services)
OTLP_ENDPOINT=http://otel-collector:4317
