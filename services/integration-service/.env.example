SERVICE_NAME=integration-service

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Topics produced for downstream consumers (defaults match webhook-dispatcher).
TOPIC_WEBHOOK_INBOUND=webhook_inbound
TOPIC_WEBHOOK_DISPATCH=webhook_dispatch

OTLP_ENDPOINT=http://jaeger:4317
OTLP_DATADOG_ENDPOINT=

LOG_LEVEL=INFO

# Sentry — leave empty to disable. Get your DSN from https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=
