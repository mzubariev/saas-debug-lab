SERVICE_NAME=integration-service

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Outbound webhook target — points to webhook-simulator in dev; replace with a
# real URL (e.g. https://webhook.site/<uuid>) for manual external testing.
# Append query params to control simulator behavior:
#   ?fail_rate=0.3&delay=2&status=500
WEBHOOK_URL=http://webhook-simulator:8001/receive-webhook

WEBHOOK_TIMEOUT=10
MAX_RETRIES=3

OTLP_ENDPOINT=http://jaeger:4317

LOG_LEVEL=INFO
