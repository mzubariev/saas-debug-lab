SERVICE_NAME=integration-service

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Target URL for outbound webhook delivery.
# Use https://webhook.site/<your-uuid> for real testing.
WEBHOOK_URL=https://webhook.site/placeholder

WEBHOOK_TIMEOUT=10
MAX_RETRIES=3

# Artificial latency injected before each outbound call (milliseconds).
SIMULATE_LATENCY_MS=0

# Probability (0.0–1.0) of a simulated outbound failure for chaos testing.
SIMULATE_FAILURE_RATE=0.0

OTLP_ENDPOINT=http://jaeger:4317

LOG_LEVEL=INFO
