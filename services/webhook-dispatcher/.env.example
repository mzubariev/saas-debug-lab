SERVICE_NAME=webhook-dispatcher

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
CONSUMER_GROUP=webhook-dispatcher

# Outbound webhook target — same role as former integration-service delivery.
# Points to webhook-simulator in dev; replace for real external testing.
WEBHOOK_URL=http://webhook-simulator:8001/receive-webhook
WEBHOOK_TIMEOUT=10
MAX_RETRIES=3

LOG_LEVEL=INFO

# Sentry — leave empty to disable.
SENTRY_DSN=
