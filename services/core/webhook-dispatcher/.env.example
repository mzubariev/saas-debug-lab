SERVICE_NAME=webhook-dispatcher

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
CONSUMER_GROUP=webhook-dispatcher

# Outbound webhook target — same role as former webhook-receiver delivery.
# Points to external-service-simulator in dev; replace for real external testing.
WEBHOOK_URL=http://nginx/external/receive-webhook
WEBHOOK_TIMEOUT=10
MAX_RETRIES=3

LOG_LEVEL=INFO

# OpenTelemetry OTLP (Jaeger + optional Datadog Agent). See infra/.env.example.
OTLP_ENDPOINT=http://otel-collector:4317

# Prometheus ``/metrics`` (threading HTTP server).
METRICS_PORT=9100

# Sentry — leave empty to disable.
SENTRY_DSN=
