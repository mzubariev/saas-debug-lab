{
  "title": "2. Webhook Pipeline",
  "uid": "webhook-pipeline",
  "tags": ["webhook", "kafka", "pipeline"],
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Webhook Success Rate %",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 95 }, { "color": "green", "value": 99 }] }
        }
      },
      "targets": [{
        "expr": "rate(webhook_requests_total{job=\"webhook-dispatcher\",status=\"success\"}[5m]) / rate(webhook_requests_total{job=\"webhook-dispatcher\"}[5m]) * 100",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "title": "Webhooks In Progress",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 100 }] } } },
      "targets": [{ "expr": "webhook_in_progress{job=\"webhook-dispatcher\"}", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Kafka Consumer Lag — dispatcher",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] } } },
      "targets": [{ "expr": "sum(kafka_consumer_lag{job=\"webhook-dispatcher\"})", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "DLQ Size",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] } } },
      "targets": [{ "expr": "dlq_size{job=\"webhook-dispatcher\"}", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Webhook Requests Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "rate(webhook_requests_total{job=\"webhook-dispatcher\"}[5m])", "legendFormat": "total", "refId": "A" },
        { "expr": "rate(webhook_failures_total{job=\"webhook-dispatcher\"}[5m])", "legendFormat": "failures", "refId": "B" },
        { "expr": "rate(webhook_retries_total{job=\"webhook-dispatcher\"}[5m])", "legendFormat": "retries", "refId": "C" }
      ]
    },
    {
      "id": 6,
      "title": "Webhook Delivery Duration P50/P95/P99",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(webhook_delivery_duration_seconds_bucket{job=\"webhook-dispatcher\"}[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(webhook_delivery_duration_seconds_bucket{job=\"webhook-dispatcher\"}[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(webhook_delivery_duration_seconds_bucket{job=\"webhook-dispatcher\"}[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 7,
      "title": "Kafka Consumer Lag — trend",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1000 }] }
        }
      },
      "targets": [
        { "expr": "sum(kafka_consumer_lag{job=\"webhook-dispatcher\"})", "legendFormat": "dispatcher lag", "refId": "A" },
        { "expr": "sum(kafka_consumer_lag{job=\"notification-worker\"})", "legendFormat": "notification lag", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "title": "Kafka Messages Consumed Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "msgps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "rate(kafka_messages_consumed_total{job=\"webhook-dispatcher\"}[5m])", "legendFormat": "dispatcher", "refId": "A" },
        { "expr": "rate(kafka_messages_consumed_total{job=\"notification-worker\"}[5m])", "legendFormat": "notification-worker", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "title": "Kafka Processing Duration P95",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(kafka_processing_duration_seconds_bucket{job=\"webhook-dispatcher\"}[5m])) by (le))", "legendFormat": "dispatcher p95", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(kafka_processing_duration_seconds_bucket{job=\"notification-worker\"}[5m])) by (le))", "legendFormat": "notification p95", "refId": "B" }
      ]
    },
    {
      "id": 10,
      "title": "DLQ — Dead Letter Queue",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 20 }, "color": { "fixedColor": "red", "mode": "fixed" } } },
      "targets": [
        { "expr": "dlq_size{job=\"webhook-dispatcher\"}", "legendFormat": "dlq size dispatcher", "refId": "A" },
        { "expr": "rate(dlq_messages_total{job=\"webhook-dispatcher\"}[5m])", "legendFormat": "dlq rate dispatcher", "refId": "B" },
        { "expr": "rate(dlq_processed_total{job=\"webhook-dispatcher\"}[5m])", "legendFormat": "dlq processed rate", "refId": "C" }
      ]
    },
    {
      "id": 11,
      "title": "Webhook Retries Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "rate(webhook_retries_total{job=\"webhook-dispatcher\"}[5m])", "legendFormat": "dispatcher retries", "refId": "A" },
        { "expr": "rate(webhook_retries_total{job=\"scheduler-worker\"}[5m])", "legendFormat": "scheduler retries", "refId": "B" }
      ]
    }
  ],
  "schemaVersion": 38
}
