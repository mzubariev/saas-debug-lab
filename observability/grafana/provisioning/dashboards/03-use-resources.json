{
  "title": "3. Resources — USE Model",
  "uid": "use-resources",
  "tags": ["use", "resources", "cpu", "memory"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU Utilization — per services",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "lineWidth": 2, "fillOpacity": 10 }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] } } },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total[5m])", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Memory (RSS) — per services",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "process_resident_memory_bytes", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "File Descriptors Utilization %",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "process_open_fds / process_max_fds * 100", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Virtual Memory — per services",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "process_virtual_memory_bytes", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Python GC — objects collected rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "rate(python_gc_objects_collected_total[5m])", "legendFormat": "{{job}} gen{{generation}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Python GC — uncollectable objects (memory leaks)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 20 }, "color": { "fixedColor": "red", "mode": "fixed" } } },
      "targets": [
        { "expr": "rate(python_gc_objects_uncollectable_total[5m])", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Celery — Active Tasks",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "celery_active_tasks", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "Celery — Queue Size",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 }] }, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "celery_queue_size", "legendFormat": "{{job}}", "refId": "A" }
      ]
    }
  ],
  "schemaVersion": 38
}
