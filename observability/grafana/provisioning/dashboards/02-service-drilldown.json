{
  "title": "2. Service Drilldown",
  "uid": "service-drilldown-v2",
  "tags": [
    "service",
    "drilldown"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "links": [
    {
      "title": "\u2190 System Health",
      "type": "link",
      "url": "/d/global-overview-v2",
      "keepTime": true,
      "icon": "external link"
    },
    {
      "title": "\u2192 Pipelines",
      "type": "link",
      "url": "/d/pipelines-v2",
      "keepTime": true,
      "icon": "external link"
    },
    {
      "title": "Kibana: logs for this service",
      "type": "link",
      "url": "http://localhost:5601/app/discover#/?_a=(query:(language:kuery,query:'service.name:\"${job}\"'))",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Open Kibana filtered to the selected service"
    },
    {
      "title": "Jaeger: traces for this service",
      "type": "link",
      "url": "http://localhost:16686/search?service=${job}&lookback=1h",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Open Jaeger filtered to the selected service"
    },
    {
      "title": "Sentry: issues for this service",
      "type": "link",
      "url": "https://mykola-zubariev.sentry.io/issues/?project=4511098962837584&query=tags%5Bservice%5D%3A${job}",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Open Sentry issues filtered to the selected service"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_requests_total, job)",
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "path",
        "type": "query",
        "label": "Path",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_requests_total{job=~\"$job\"}, path)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "RPS",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=~\"$job\",path=~\"$path\"}[5m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=~\"$job\",path=~\"$path\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=~\"$job\",path=~\"$path\"}[5m])),1)",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "P95 Latency",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\"$job\",path=~\"$path\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "In-flight",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(http_requests_in_progress{job=~\"$job\",path=~\"$path\"})",
          "legendFormat": "in-flight",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Error Rate by Endpoint",
      "description": "Which specific path is returning errors?",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (path) (rate(http_requests_total{job=~\"$job\",path=~\"$path\",status=~\"5..\"}[5m])) / clamp_min(sum by (path) (rate(http_requests_total{job=~\"$job\",path=~\"$path\"}[5m])),1)",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "RPS by Endpoint",
      "description": "Traffic distribution \u2014 where is the load?",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (path) (rate(http_requests_total{job=~\"$job\",path=~\"$path\"}[5m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Latency p50 / p95 / p99 by Endpoint",
      "description": "All percentiles in one view \u2014 wide gap between p95 and p99 = occasional spikes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (path, le) (rate(http_request_duration_seconds_bucket{job=~\"$job\",path=~\"$path\"}[5m])))",
          "legendFormat": "p50 {{path}}",
          "exemplar": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (path, le) (rate(http_request_duration_seconds_bucket{job=~\"$job\",path=~\"$path\"}[5m])))",
          "legendFormat": "p95 {{path}}",
          "exemplar": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (path, le) (rate(http_request_duration_seconds_bucket{job=~\"$job\",path=~\"$path\"}[5m])))",
          "legendFormat": "p99 {{path}}",
          "exemplar": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 12,
      "title": "↓ External Calls (from API Gateway)",
      "description": "These panels are only populated when api-gateway is selected. All metrics are recorded inside api-gateway and reflect its outbound calls to downstream services.",
      "type": "row",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "title": "Outbound Requests to Downstream Services",
      "description": "Requests made by api-gateway to each downstream service, broken by HTTP status. Only populated when api-gateway is selected.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, status) (rate(upstream_requests_total{job=\"api-gateway\"}[5m]))",
          "legendFormat": "{{service}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Downstream Error Rate (api-gateway view)",
      "description": "Percentage of api-gateway's outbound calls to each downstream service that resulted in 5xx, timeout, or connection error.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(upstream_requests_total{job=\"api-gateway\", status=~\"5..|timeout|connection_error\"}[5m])) / clamp_min(sum by (service) (rate(upstream_requests_total{job=\"api-gateway\"}[5m])), 1)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Downstream P95 Latency (api-gateway view)",
      "description": "Round-trip latency at p95 as measured by api-gateway for each call to a downstream service. Spike = slow downstream DB, handler, or network.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 49, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(upstream_request_duration_seconds_bucket{job=\"api-gateway\"}[5m])))",
          "legendFormat": "{{service}}",
          "exemplar": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Downstream P99 Latency (api-gateway view)",
      "description": "Tail (p99) round-trip latency as measured by api-gateway for each call to a downstream service. Useful for spotting intermittent slowness invisible at p95.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 49, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(upstream_request_duration_seconds_bucket{job=\"api-gateway\"}[5m])))",
          "legendFormat": "{{service}}",
          "exemplar": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Logs \u2014 $job",
      "description": "Application logs for the selected service within the dashboard time range. Filter further by level, trace_id, or event_name in the search bar.",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false,
        "displayedFields": [
          "trace_id",
          "service.name",
          "event_name",
          "level",
          "status",
          "exception",
          "message",
          "upstream",
          "request_id"
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "elasticsearch",
            "uid": "elasticsearch"
          },
          "query": "service.name:\"$job\"",
          "metrics": [
            {
              "id": "1",
              "type": "logs",
              "settings": {
                "limit": "500"
              }
            }
          ],
          "timeField": "@timestamp",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}