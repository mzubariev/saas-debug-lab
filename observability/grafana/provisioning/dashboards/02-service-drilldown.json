{
  "title": "2. Service Drilldown",
  "uid": "service-drilldown-v2",
  "tags": ["service", "drilldown"],
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "links": [
    {
      "title": "← System Health",
      "type": "link",
      "url": "/d/global-overview-v2",
      "keepTime": true,
      "icon": "external link"
    },
    {
      "title": "→ Pipelines",
      "type": "link",
      "url": "/d/pipelines-v2",
      "keepTime": true,
      "icon": "external link"
    },
    {
      "title": "Kibana: logs for this service",
      "type": "link",
      "url": "http://localhost:5601/app/discover#/?_a=(query:(language:kuery,query:'service.name:\"${job}\"'))",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Open Kibana filtered to the selected service"
    },
    {
      "title": "Jaeger: traces for this service",
      "type": "link",
      "url": "http://localhost:16686/search?service=${job}&lookback=1h",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Open Jaeger filtered to the selected service"
    },
    {
      "title": "Sentry: issues for this service",
      "type": "link",
      "url": "https://mykola-zubariev.sentry.io/issues/?project=4511098962837584&query=tags%5Bservice%5D%3A${job}",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Open Sentry issues filtered to the selected service"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, job)",
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "path",
        "type": "query",
        "label": "Path",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total{job=~\"$job\"}, path)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "RPS",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "mappings": [] }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{job=~\"$job\",path=~\"$path\"}[5m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{job=~\"$job\",path=~\"$path\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=~\"$job\",path=~\"$path\"}[5m])),1)",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "P95 Latency",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\"$job\",path=~\"$path\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "In-flight",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(http_requests_in_progress{job=~\"$job\",path=~\"$path\"})",
          "legendFormat": "in-flight",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Error Rate by Endpoint",
      "description": "Which specific path is returning errors?",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (path) (rate(http_requests_total{job=~\"$job\",path=~\"$path\",status=~\"5..\"}[5m])) / clamp_min(sum by (path) (rate(http_requests_total{job=~\"$job\",path=~\"$path\"}[5m])),1)",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "RPS by Endpoint",
      "description": "Traffic distribution — where is the load?",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (path) (rate(http_requests_total{job=~\"$job\",path=~\"$path\"}[5m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Latency p50 / p95 / p99 by Endpoint",
      "description": "All percentiles in one view — wide gap between p95 and p99 = occasional spikes",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (path, le) (rate(http_request_duration_seconds_bucket{job=~\"$job\",path=~\"$path\"}[5m])))",
          "legendFormat": "p50 {{path}}",
          "exemplar": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (path, le) (rate(http_request_duration_seconds_bucket{job=~\"$job\",path=~\"$path\"}[5m])))",
          "legendFormat": "p95 {{path}}",
          "exemplar": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (path, le) (rate(http_request_duration_seconds_bucket{job=~\"$job\",path=~\"$path\"}[5m])))",
          "legendFormat": "p99 {{path}}",
          "exemplar": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "title": "Upstream Calls by Service (api-gateway only)",
      "description": "Only populated when api-gateway is selected. Shows latency and errors to each downstream service.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service, status) (rate(upstream_requests_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{service}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Upstream P95 Latency (api-gateway only)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(upstream_request_duration_seconds_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "{{service}}",
          "exemplar": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Logs — $job",
      "description": "Application logs for the selected service within the dashboard time range. Filter further by level, trace_id, or event_name in the search bar.",
      "type": "logs",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 10 },
      "datasource": { "type": "elasticsearch", "uid": "elasticsearch" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "elasticsearch", "uid": "elasticsearch" },
          "query": "service.name:\"$job\"",
          "metrics": [
            {
              "id": "1",
              "type": "logs",
              "settings": { "limit": "500" }
            }
          ],
          "timeField": "@timestamp",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Recent Traces — $job",
      "description": "Trace search results. Click a Trace ID to open the full span timeline in Jaeger.",
      "type": "table",
      "gridPos": { "x": 0, "y": 38, "w": 24, "h": 10 },
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "options": {
        "cellHeight": "sm",
        "footer": { "enablePagination": false },
        "sortBy": [{ "displayName": "Start time", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "traceID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Jaeger",
                    "url": "http://localhost:16686/trace/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Start time" },
            "properties": [{ "id": "unit", "value": "dateTimeAsMs" }]
          },
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [{ "id": "unit", "value": "µs" }]
          }
        ]
      },
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "traceName",
                "config": { "id": "regex", "options": { "value": "health|metrics|readiness|liveness" } }
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "jaeger", "uid": "jaeger" },
          "queryType": "search",
          "service": "$job",
          "limit": 20,
          "refId": "A"
        }
      ]
    }
  ]
}
