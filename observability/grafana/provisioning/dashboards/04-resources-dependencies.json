{
  "title": "4. Resources & Dependencies",
  "uid": "resources-deps-v2",
  "tags": ["use", "deps"],
  "panels": [
    {
      "title": "CPU (cores)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[5m])"
        }
      ]
    },
    {
      "title": "Memory",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_resident_memory_bytes"
        }
      ]
    },
    {
      "title": "FD Usage",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_open_fds / process_max_fds"
        }
      ]
    },
    {
      "title": "Upstream Error Rate",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(upstream_requests_total{status=~\"5..\"}[5m])) by (service) / clamp_min(sum(rate(upstream_requests_total[5m])) by (service),1)"
        }
      ]
    },
    {
      "title": "Upstream Latency p95",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(upstream_request_duration_seconds_bucket[5m])) by (service, le))"
        }
      ]
    }
  ],
  "schemaVersion": 38
}