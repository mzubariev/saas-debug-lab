{
  "title": "4. Resources & Dependencies",
  "uid": "resources-deps-v2",
  "tags": ["resources", "deps"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "links": [
    {
      "title": "← System Health",
      "type": "link",
      "url": "/d/global-overview-v2",
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(process_resident_memory_bytes, job)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU Saturation by Service (% of machine cores)",
      "description": "Fraction of total machine CPU capacity consumed per service (rate(process_cpu_seconds_total) / machine_cpu_cores). 1.0 = 100% of all available cores. machine_cpu_cores is exported by each service via saas_shared.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "last"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (rate(process_cpu_seconds_total{job=~\"$job\"}[5m])) / on(job) group_left() machine_cpu_cores{job=~\"$job\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory Usage (% of container limit)",
      "description": "Resident memory as a fraction of the container memory limit (process_resident_memory_bytes / container_memory_limit_bytes). container_memory_limit_bytes is exported by each service via saas_shared (read from cgroups at startup). Shows 'No data' if no memory limit is set on the container.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_resident_memory_bytes{job=~\"$job\"} / container_memory_limit_bytes{job=~\"$job\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Task Processing Latency p95 by Operation",
      "description": "DB operation latency for task-service CRUD — spike = slow DB or lock contention",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(task_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "{{operation}}",
          "exemplar": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "FD Usage (% of limit) by Service",
      "description": "Fraction of OS file-descriptor limit in use. Approaching 1.0 = connection/handle leak. Absolute FD count shown on right axis for context.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 4] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "semi-dark-blue" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_open_fds{job=~\"$job\"} / process_max_fds{job=~\"$job\"}",
          "legendFormat": "{{job}} FD%",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_open_fds{job=~\"$job\"}",
          "legendFormat": "{{job}} (abs)",
          "refId": "B"
        }
      ]
    }
  ]
}
