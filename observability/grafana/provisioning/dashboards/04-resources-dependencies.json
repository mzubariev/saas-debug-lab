{
  "title": "4. Resources & Dependencies",
  "uid": "resources-deps-v2",
  "tags": ["resources", "deps"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "links": [
    {
      "title": "← System Health",
      "type": "link",
      "url": "/d/global-overview-v2",
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(process_resident_memory_bytes, job)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU Saturation by Service (% of machine cores)",
      "description": "Fraction of total machine CPU capacity consumed per service (rate(process_cpu_seconds_total) / machine_cpu_cores). 1.0 = 100% of all available cores. Denominator uses max by (job) so multiproc workers (e.g. Celery prefork) do not duplicate machine_cpu_cores per pid.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "last"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (rate(process_cpu_seconds_total{job=~\"$job\"}[5m])) / on(job) group_left() max by (job) (machine_cpu_cores{job=~\"$job\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory Usage (% of container limit)",
      "description": "Resident memory as a fraction of the container memory limit. Numerator sums RSS by job (multiproc workers); denominator is max by (job) of container_memory_limit_bytes (same limit per container). Shows 'No data' if no memory limit is set on the container.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (process_resident_memory_bytes{job=~\"$job\"}) / on(job) group_left() max by (job) (container_memory_limit_bytes{job=~\"$job\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Task Processing Latency p95 by Operation",
      "description": "DB operation latency for task-service CRUD — spike = slow DB or lock contention",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(task_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "{{operation}}",
          "exemplar": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "FD Usage (% of limit) by Service",
      "description": "Fraction of OS file-descriptor limit in use. Approaching 1.0 = connection/handle leak. Absolute FD count shown on right axis for context.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 4] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "semi-dark-blue" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_open_fds{job=~\"$job\"} / process_max_fds{job=~\"$job\"}",
          "legendFormat": "{{job}} FD%",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_open_fds{job=~\"$job\"}",
          "legendFormat": "{{job}} (abs)",
          "refId": "B"
        }
      ]
    }
  ,
    {
      "id": 7,
      "title": "↓ PostgreSQL",
      "type": "row",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 1 },
      "collapsed": false,
      "datasource": null,
      "targets": []
    },
    {
      "id": 8,
      "title": "DB Connections by State",
      "description": "Connection count grouped by pg_stat_activity state. active = executing a query. idle = connected but doing nothing (connection pool overhead). idle in transaction = inside a BEGIN block but not executing — a sustained spike here means hung transactions and lock contention risk. max_connections (dashed) is the PostgreSQL cluster limit; hitting it causes 'too many connections' errors.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 17, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max_connections" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } },
              { "id": "custom.lineWidth", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "active" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "idle in transaction" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_connections_by_state_count",
          "legendFormat": "{{state}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_settings_max_connections",
          "legendFormat": "max_connections",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "Rows Returned / s",
      "description": "rate(pg_stat_database_tup_returned) = rows produced by sequential scans. rate(pg_stat_database_tup_fetched) = rows fetched via index scans. A high seq-scan row rate with a low index-fetch rate indicates missing indexes. Both drop to zero = no queries running.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 17, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "last"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (datname) (rate(pg_stat_database_tup_returned{datname!~\"template.*|postgres\"}[5m]))",
          "legendFormat": "seq scan rows / s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (datname) (rate(pg_stat_database_tup_fetched{datname!~\"template.*|postgres\"}[5m]))",
          "legendFormat": "index rows / s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "Query Latency p50 / p95 / p99",
      "description": "Percentiles of per-query mean execution time from pg_stat_statements (queries with > 5 calls). p50 = typical query, p95/p99 = tail latency. Spike = slow query introduced or table grew without index update. Requires pg_stat_statements extension (enabled via shared_preload_libraries). If this panel shows No Data, run: docker exec postgres psql -U $POSTGRES_USER -d $POSTGRES_DB -c 'CREATE EXTENSION IF NOT EXISTS pg_stat_statements;'",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_query_latency_percentiles_p50_seconds",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_query_latency_percentiles_p95_seconds",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_query_latency_percentiles_p99_seconds",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 11,
      "title": "Slow Queries (running > 1 s)",
      "description": "Number of queries currently executing for more than 1 second, sampled every 30 s. 0 = normal. A sustained non-zero value = long-running query blocking other transactions (lock contention) or missing index on a large table. Correlate with 'idle in transaction' connections in the panel above and with 'Task Processing Latency p95' in this dashboard.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red",    "value": 3 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "line+area" }
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_slow_queries_count",
          "legendFormat": "slow queries",
          "refId": "A"
        }
      ]
    }
  ]
}
