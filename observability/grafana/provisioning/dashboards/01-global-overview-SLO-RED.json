{
  "title": "1. System Health",
  "uid": "global-overview-v2",
  "tags": ["overview", "slo"],
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "links": [
    {
      "title": "→ Service Drilldown",
      "type": "link",
      "url": "/d/service-drilldown-v2?var-job=api-gateway",
      "keepTime": true,
      "includeVars": true,
      "icon": "external link",
      "tooltip": "Service Drilldown"
    },
    {
      "title": "→ Pipelines",
      "type": "link",
      "url": "/d/pipelines-v2",
      "keepTime": true,
      "icon": "external link",
      "tooltip": "Kafka · Webhooks · Celery"
    },
    {
      "title": "→ Resources",
      "type": "link",
      "url": "/d/resources-deps-v2",
      "keepTime": true,
      "icon": "external link",
      "tooltip": "Resources · Dependencies"
    },
    {
      "title": "Kibana Logs",
      "type": "link",
      "url": "http://localhost:5601/app/discover",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Open Kibana (filter by service.name or trace_id)"
    },
    {
      "title": "Jaeger Traces",
      "type": "link",
      "url": "http://localhost:16686",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Open Jaeger"
    },
    {
      "title": "Sentry issues",
      "type": "link",
      "url": "https://nz-n3.sentry.io/issues/?project=4511340984795216",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Open Sentry issues filtered to the selected service"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Services / Containers Availability",
      "description": "1 tile per scrape target. Green = UP, Red = DOWN. Any red tile means Prometheus cannot reach that container.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red"   } } },
            { "type": "value", "options": { "1": { "text": "UP",   "color": "green" } } }
          ]
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["last"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min by (job) (up)",
          "legendFormat": "{{job}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "RPS (All Services)",
      "description": "Total HTTP requests per second across all services, excluding /metrics and /health. Drop toward 0 = no traffic or all services down.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "mappings": [], "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 10 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["last"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{path!~\"/metrics|/health\"}[5m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate (All Services)",
      "description": "5xx+4xx / total across all services. Yellow > 1%, red > 5%. Drill into 'Error Rate by Service' below to find the offender.",
      "type": "stat",
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["last"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{status=~\"4..|5..\", path!~\"/metrics|/health\"}[5m])) / clamp_min(sum(rate(http_requests_total{path!~\"/metrics|/health\"}[5m])),1)",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "P95 Latency (Worst Service)",
      "description": "Highest p95 latency across all services at this moment. Yellow > 500ms, red > 1s. Use 'P95 Latency by Service' below to identify which service is slow.",
      "type": "stat",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["last"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket{path!~\"/metrics|/health\"}[5m]))))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Top 5 Failing Endpoints (global)",
      "description": "The 5 highest-error-rate (job, method, path, status) combinations across the entire fleet right now. Click a bar to drill into that service.",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red",   "value": 0.1 }
            ]
          },
          "links": [
            {
              "title": "→ Service Drilldown",
              "url": "/d/service-drilldown-v2?var-job=${__field.labels.job}",
              "targetBlank": false
            }
          ]
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["last"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(5, sum by (job, method, path, status) (rate(http_requests_total{status=~\"4..|5..\", path!~\"/metrics|/health\"}[5m])))",
          "legendFormat": "{{job}}  {{method}}  {{path}}  {{status}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Error Rate by Service",
      "description": "5xx+4xx error rate split by service and status code. Identify which service and which HTTP error type is spiking, then click '→ Service Drilldown' to investigate per-endpoint detail.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, status) (rate(http_requests_total{status=~\"4..|5..\", path!~\"/metrics|/health\"}[5m])) / on(job) group_left() clamp_min(sum by (job) (rate(http_requests_total{path!~\"/metrics|/health\"}[5m])), 1)",
          "legendFormat": "{{job}} — {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "P95 Latency by Service",
      "description": "p95 request latency per service. A rising line = degraded performance. Click '→ Service Drilldown' to see per-endpoint breakdown and linked traces (exemplar dots).",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket{path!~\"/metrics|/health\"}[5m])))",
          "legendFormat": "{{job}}",
          "exemplar": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Kafka Consumer Lag (total)",
      "description": "Total consumer lag, exported by kafka-exporter. Rising = pipeline backing up; sudden jump = consumer crashed. See Pipelines dashboard for full detail.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 24, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["last"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(kafka_consumergroup_lag)",
          "legendFormat": "lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Webhook Delivery Success Rate",
      "description": "Of all webhook events that resolved (delivered OR permanently failed to DLQ), what fraction succeeded. Always 0–100%. < 99% = events are being permanently lost to the DLQ instead of being delivered.",
      "type": "stat",
      "gridPos": { "x": 6, "y": 24, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",  "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green",  "value": 0.99 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["last"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(webhook_requests_total{status=\"success\"}[5m])) / clamp_min(sum(rate(webhook_requests_total{status=\"success\"}[5m])) + sum(rate(dlq_messages_total[5m])), 1e-9)",
          "legendFormat": "delivered / resolved",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "DLQ Size (Kafka)",
      "description": "Unprocessed messages in webhook_dlq for the scheduler-worker consumer group, as reported by kafka-exporter. > 0 = webhooks waiting for retry.",
      "type": "stat",
      "gridPos": { "x": 12, "y": 24, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["last"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"scheduler-worker\", topic=\"webhook_dlq\"})",
          "legendFormat": "dlq",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Celery Queue Size (Redis)",
      "description": "Tasks waiting to run (cleanup, retry webhooks)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 24, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["last"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(celery_queue_size)",
          "legendFormat": "queue",
          "refId": "A"
        }
      ]
    }
  ]
}
